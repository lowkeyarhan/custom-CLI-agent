# Your provider preference
PROVIDER=openrouter # openrouter, openai, anthropic, google, custom

# Provide the API key for your chosen provider
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
CUSTOM_API_KEY=...

# Models
OPENROUTER_MODEL=google/gemini-2.5-pro

# Custom OpenAI-compatible endpoints (Ollama, vLLM, LM Studio)
CUSTOM_BASE_URL=http://localhost:11434/v1

# OpenRouter specific headers
APP_NAME=lowkeyarhan
APP_URL=http://localhost
